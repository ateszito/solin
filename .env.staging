# ============================================================
# Solin — STAGING (solin-staging.ateszito.com :8081, branch: staging)
# Single source of truth: docs/THREE_ENV_ARCHITECTURE.md sec 3 + 4.2.
# Values that differ per-env are the 3 hostnames below + LOG_LEVEL +
# RATE_LIMIT + secrets (POSTGRES_PASSWORD, JWT_SECRET_KEY).
# DO NOT COMMIT REAL SECRETS. The values here are the canonical shape;
# CI (sec 7.4) exports them or reads them from secrets/ at deploy time.
# ============================================================

# ---- Tier A: identity ----
SOLIN_ENV=staging
APP_VERSION=v0.0.0-staging+local

# ---- Tier A: URLs (staging hostname) ----
API_BASE_URL=https://solin-staging.ateszito.com
PUBLIC_BASE_URL=https://solin-staging.ateszito.com
CORS_ORIGINS=https://solin-staging.ateszito.com

# ---- Tier A: feature flags (all true per blueprint sec 3.1, all 3 envs) ----
FEATURE_ALLOW_EDIT=true
FEATURE_INVISIBILITY=true

# ---- Tier A: debug/logging (staging = info) ----
DEBUG=false
LOG_LEVEL=info
RATE_LIMIT_PER_MIN=120

# ---- Tier B: Postgres (separate container + DB per sec 4.2) ----
DATABASE_URL=postgresql://solin:***@solin-staging-db:5432/solin_staging
POSTGRES_DB=solin_staging
POSTGRES_USER=solin
POSTGRES_PASSWORD=***
JWT_SECRET_KEY=stagin…only

# ---- Cloudflare tunnel (optional; used only by the DNS+containers slice) ----
# Uncomment and fill on the deploy host when CNAME/tunnel work is in scope.
# CLOUDFLARE_API_TOKEN=
*** CLOUDFLARE_ACCOUNT_ID=
*** CLOUDFLARE_ZONE_ID=
