# ============================================================
# Solin — PRODUCTION (solin.ateszito.com :8080, branch: main)
# Single source of truth: docs/THREE_ENV_ARCHITECTURE.md sec 3 + 4.2.
# DO NOT COMMIT REAL SECRETS. POSTGRES_PASSWORD / JWT_SECRET_KEY are
# injected by the self-hosted-runner deploy (sec 7.4) from the secrets/
# dir on the Mac, or from the runner env — never committed.
# ============================================================

# ---- Tier A: identity ----
SOLIN_ENV=production
APP_VERSION=v0.0.0-prod+local

# ---- Tier A: URLs (production hostname) ----
API_BASE_URL=https://solin.ateszito.com
PUBLIC_BASE_URL=https://solin.ateszito.com
CORS_ORIGINS=https://solin.ateszito.com

# ---- Tier A: feature flags (all true per blueprint sec 3.1, all 3 envs) ----
FEATURE_ALLOW_EDIT=true
FEATURE_INVISIBILITY=true

# ---- Tier A: debug/logging (production = info) ----
DEBUG=false
LOG_LEVEL=info
RATE_LIMIT_PER_MIN=60

# ---- Tier B: Postgres (separate container + DB per sec 4.2) ----
DATABASE_URL=postgresql://solin:***@solin-prod-db:5432/solin_prod
POSTGRES_DB=solin_prod
POSTGRES_USER=solin
POSTGRES_PASSWORD=***
JWT_SECRET_KEY=produc…only

# ---- Cloudflare tunnel (optional; used only by the DNS+containers slice) ----
# Uncomment and fill on the deploy host when CNAME/tunnel work is in scope.
# CLOUDFLARE_API_TOKEN=
*** CLOUDFLARE_ACCOUNT_ID=
*** CLOUDFLARE_ZONE_ID=
