# ============================================================
# Solin — .env.example (documented template, blueprint sec 3 + 4.2)
# ------------------------------------------------------------
# Single source of truth for the variable CONTRACT:
#   docs/THREE_ENV_ARCHITECTURE.md section 3 (Tier A + Tier B)
#
# This file lists EVERY variable the 3-env stack consumes, with the
# allowed values / per-env shapes. It is committed (no secrets).
#
# Concrete per-env files ARE committed too and mirror this variable set:
#   .env.development   (development, solin-dev.ateszito.com   :8082)
#   .env.staging       (staging,     solin-staging.ateszito.com :8081)
#   .env.production    (production,  solin.ateszito.com       :8080)
# docker-compose.yml and the FastAPI backend read the SAME variable
# names — a variable that appears here must be documented in sec 3
# first (contract rule: new var = doc change, then code).
#
# Secrets (POSTGRES_PASSWORD, JWT_SECRET_KEY) are placeholders below.
# Real values are injected by the deploy job (secrets/ dir on the Mac
# or runner env) — NEVER committed, NEVER logged.
# ============================================================

# ---- Tier A: env identity (injected at BUILD time, blueprint sec 7.3) ----
# Allowed: development | staging | production
# Used by: UI badge (app/config.js), /healthz, /api/env, logging, doc gate
SOLIN_ENV=development
# SemVer + short SHA, set by CI at build time (sec 7.3):
#   development = v<ver>-dev+<sha> | staging = v<ver>.rc1+<sha> | production = v<ver>+<sha>
APP_VERSION=v0.0.0-dev+local

# ---- Tier A: URLs (the 3 hostnames on the Cloudflare tunnel, sec 4.3) ----
# development  = https://solin-dev.ateszito.com
# staging      = https://solin-staging.ateszito.com
# production   = https://solin.ateszito.com
# API_BASE_URL = base URL the SPA calls (same origin via tunnel)
API_BASE_URL=https://solin-dev.ateszito.com
# PUBLIC_BASE_URL = canonical host for <link rel=canonical>/OG/self
PUBLIC_BASE_URL=https://solin-dev.ateszito.com
# CORS_ORIGINS = origins the FastAPI backend allows (backend side of
# the same cross-origin story as API_BASE_URL); comma-separated
CORS_ORIGINS=https://solin-dev.ateszito.com

# ---- Tier A: feature flags (blueprint sec 3.1 — all true today) ----
# FEATURE_ALLOW_EDIT    = enable the ✎ edit UI (detail.js + config.js gate)
FEATURE_ALLOW_EDIT=true
# FEATURE_INVISIBILITY  = inventory / what-I-have module (nav gate)
FEATURE_INVISIBILITY=true

# ---- Tier A: debug / logging (per-env defaults) ----
# DEBUG: development=true | staging=false | production=false
#        (verbose logging; also gates /docs + /redoc on the API)
DEBUG=true
# LOG_LEVEL: development=debug | staging=info | production=info
LOG_LEVEL=debug
# RATE_LIMIT_PER_MIN: development=0 (off) | staging=120 | production=60
RATE_LIMIT_PER_MIN=0

# ---- Tier B: Postgres (per-env container + DB + named volume, sec 4.2) ----
# Container names: solin-dev-db / solin-staging-db / solin-prod-db
# DB names:        solin_dev   / solin_staging   / solin_prod
# DSN host:        solin-dev-db:5432 / solin-staging-db:5432 / solin-prod-db:5432
DATABASE_URL=postgresql://solin:***@solin-dev-db:5432/solin_dev
POSTGRES_DB=solin_dev
POSTGRES_USER=solin
POSTGRES_PASSWORD=***
# JWT_SECRET_KEY: dev secret | staging secret | production secret (unique)
JWT_SECRET_KEY=***
