# ============================================================
# Solin — DEVELOPMENT (solin-dev.ateszito.com :8082, feature/* branches)
# Single source of truth: docs/THREE_ENV_ARCHITECTURE.md sec 3 + 4.2.
# This file doubles as the "keys + shapes" template (the former
# `.env.example`) — all three concrete .env.{development,staging,
# production} files mirror its variable set.
# DO NOT COMMIT REAL SECRETS. POSTGRES_PASSWORD / JWT_SECRET_KEY are
# injected by the self-hosted-runner deploy (sec 7.4) from the secrets/
# dir on the Mac, or from the runner env — never committed.
# ============================================================

# ---- Tier A: identity ----
# development = 'development' | staging = 'staging' | production = 'production'
SOLIN_ENV=development
# SemVer + short SHA, injected at BUILD time (blueprint sec 7.3):
#   APP_VERSION="v1.2.3+<sha>"
APP_VERSION=v0.0.0-dev+local

# ---- Tier A: URLs ----
# API base the SPA talks to (CORS_ORIGINS is set to the same value on the
# backend side, so browsers get a consistent cross-origin story).
API_BASE_URL=https://solin-dev.ateszito.com
PUBLIC_BASE_URL=https://solin-dev.ateszito.com
CORS_ORIGINS=https://solin-dev.ateszito.com

# ---- Tier A: feature flags (blueprint sec 3.1, all true today) ----
FEATURE_ALLOW_EDIT=true
FEATURE_INVISIBILITY=true

# ---- Tier A: debug/logging ----
DEBUG=true
LOG_LEVEL=debug
# 0 = rate-limit disabled (dev convenience); 120 = staging; 60 = production
RATE_LIMIT_PER_MIN=0

# ---- Tier B: Postgres ----
# Hostname follows the blueprint sec 4.2 (solin-{env}-db on solin_net).
DATABASE_URL=postgresql://solin:***@solin-dev-db:5432/solin_dev
POSTGRES_DB=solin_dev
POSTGRES_USER=solin
# Secrets below — NEVER commit real values.
POSTGRES_PASSWORD=***
JWT_SECRET_KEY=dev-o…only

# ---- Cloudflare tunnel (optional for local build) ----
# Used only by the DNS+containers slice; leave out when not needed.
# CLOUDFLARE_API_TOKEN=
*** CLOUDFLARE_ACCOUNT_ID=
*** CLOUDFLARE_ZONE_ID=
