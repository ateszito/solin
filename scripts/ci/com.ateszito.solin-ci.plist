<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.ateszito.solin-ci — Solin push→deploy trigger (60s poll of
  ateszito/solin branch tips → scripts/ci/deploy.sh <env>).
  See DEPLOY.md in the repo.
  Install:  cp scripts/ci/com.ateszito.solin-ci.plist ~/Library/LaunchAgents/
            launchctl load ~/Library/LaunchAgents/com.ateszito.solin-ci.plist
  Remove:   launchctl unload ~/Library/LaunchAgents/com.ateszito.solin-ci.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ateszito.solin-ci</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/agnesbudai/Documents/Solin/scripts/ci/ci-poll.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/agnesbudai/Documents/Solin/.cicd/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/agnesbudai/Documents/Solin/.cicd/launchd.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/agnesbudai</string>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
  </dict>
</dict>
</plist>
