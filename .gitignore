Solin — Recipe Platform

# Environment files — per-tier files (.env.development / .env.staging /
# .env.production) ARE committed and are the single source of truth for
# each env's configuration (blueprint sec 3.2, 3.3). Only the local
# secrets file and ad-hoc overrides stay out of git.
.env
.env.local
.env.*.local

# Python
__pycache__
*.py[cod]
*.so
.pytest_cache
.mypy_cache
/.venv/
/venv/
requirements.txt

# Node
node_modules/
.next/
out/
npm-debug.log*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Media (use separate storage)
*.mp4
*.mov
*.avi

# Runtime / test artifacts
/media/
/.test_tmp/

# Sensitive
secrets/

# OS
Thumbs.db

# DB dumps
*.sql.gz

# CI/CD state (logs, last-seen markers, snapshots)
/.cicd/
